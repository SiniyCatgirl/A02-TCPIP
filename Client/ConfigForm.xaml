<Window x:Class="TCP_Client.ConfigForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TCP_Client"
        mc:Ignorable="d"
        Title="Configure Settings"
        Height="225" Width="500" 
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Server IP & Port -->
        <TextBlock x:Name="labelServerIP" Text="Server IP:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" TextAlignment="Center" Height="16"/>
        <TextBox x:Name="txtServerIP" Grid.Row="1" Grid.Column="1" Margin="5,8,5,2"/>
        <TextBlock x:Name="labelServerPort" Text="Server Port:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" TextAlignment="Center" Height="16"/>
        <TextBox x:Name="txtServerPort" Grid.Row="2" Grid.Column="1" Margin="5,8,5,2"/>

        <!-- Game Time Limit -->
        <TextBlock x:Name="labelTimeLimit" Text="Time Limit (Seconds):" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" TextAlignment="Center" Height="16"/>
        <TextBox x:Name="txtConfigTimeLimit" Grid.Row="3" Grid.Column="1" Margin="5,8,5,2"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0" Grid.Column="1" Width="170">
            <Button Content="OK" Width="80" Margin="0,0,10,0" Click="btnOk_Click"/>
            <Button Content="Cancel" Width="80" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
