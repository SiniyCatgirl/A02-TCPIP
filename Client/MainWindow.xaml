<Window x:Class="Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="650">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="File_Exit_Click"/>
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Config" Click="Edit_Config_Click"/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="Help_About_Click"/>
            </MenuItem>
        </Menu>
        <Grid>
            <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" Margin="18,50,482,16" Width="150" Height="350" HorizontalContentAlignment="Center"/>
            <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" Margin="482,50,18,16" Height="350" Width="150" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            <Label x:Name="labelCorrect" Content="Correct Words" HorizontalAlignment="Left" Margin="50,19,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <Label x:Name="labelIncorrect" Content="Incorrect Words" HorizontalAlignment="Left" Margin="510,19,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <TextBox x:Name="txtStringClue" HorizontalAlignment="Center" Margin="0,50,0,0" TextWrapping="Wrap" Text="String" VerticalAlignment="Top" Width="250" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            <TextBox x:Name="txtGuess" HorizontalAlignment="Center" Margin="0,268,0,0" TextWrapping="Wrap" Text="Make A Guess" VerticalAlignment="Top" Width="120" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            <Label x:Name="labelStringClue" Content="Clue" HorizontalAlignment="Center" Margin="0,19,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <Label x:Name="labelGuess" Content="Guess" HorizontalAlignment="Center" Margin="0,237,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <Label x:Name="labelWordsLeft" Content="Words Left" HorizontalAlignment="Center" Margin="0,351,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <Button x:Name="btnSubmit" Content="Submit" HorizontalAlignment="Center" Margin="0,291,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="txtWordsLeft" HorizontalAlignment="Center" Margin="0,382,0,0" TextWrapping="Wrap" Text="# of Words Left" VerticalAlignment="Top" Width="120" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            <TextBox x:Name="txtTimer" HorizontalAlignment="Center" Margin="0,175,0,0" TextWrapping="Wrap" Text="Timer" VerticalAlignment="Top" Width="120" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            <Label x:Name="labelTimer" Content="Timer" HorizontalAlignment="Center" Margin="0,144,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

        </Grid>
    </DockPanel>
</Window>
