<Window x:Class="TCP_Client.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Height="300" Width="400"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="PROJECT: PROG2126 – A02 – TCPIP"
                       FontWeight="Bold" FontSize="14" TextAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="PROGRAMMERS: Josh Visentin, Jonathan Paventi, Trent Beitz"
                       FontSize="13" TextAlignment="Center" Margin="0,0,0,5"/>

            <TextBlock Text="FIRST VERSION: 2026-02-10"
                       FontSize="13" TextAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="DESCRIPTION:"
                       FontWeight="Bold" FontSize="13" Margin="0,0,0,5"/>
            <TextBlock Text="This project simulates a game that involves a Client and Server interaction."
                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,15"/>

            <Button Content="OK" Width="80" Height="30" HorizontalAlignment="Center"
                    Click="Ok_Click" Background="#0078D7" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
